<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SystemMonitor.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="760"
        x:Class="SystemMonitor.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Sentinel System Monitor"
        Width="1180"
        Height="760"
        MinWidth="980"
        MinHeight="640"
        Background="#F5F7FA">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#172033"/>
        </Style>

        <Style Selector="TextBlock.caption">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#64748B"/>
        </Style>

        <Style Selector="Border.panel">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <Style Selector="ProgressBar">
            <Setter Property="Height" Value="8"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
    </Window.Styles>

    <ScrollViewer>
        <Grid RowDefinitions="Auto,Auto,*"
              Margin="28"
              RowSpacing="22">

            <Grid ColumnDefinitions="*,Auto"
                  VerticalAlignment="Center">
                <StackPanel Spacing="4">
                    <TextBlock Text="{Binding AppTitle}"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="#111827"/>
                    <TextBlock Text="Мониторинг состояния компьютера и Telegram-уведомления"
                               Classes="caption"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Spacing="6">
                    <Border Background="#DCFCE7"
                            CornerRadius="14"
                            Padding="12,6"
                            HorizontalAlignment="Right">
                        <TextBlock Text="{Binding StatusText}"
                                   Foreground="#166534"
                                   FontWeight="SemiBold"/>
                    </Border>
                    <TextBlock Text="{Binding LastUpdate}"
                               Classes="caption"
                               HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1"
                  ColumnDefinitions="*,*,*,*"
                  ColumnSpacing="16">
                <Border Classes="panel">
                    <StackPanel Spacing="12">
                        <TextBlock Text="CPU" Classes="caption"/>
                        <TextBlock Text="{Binding CpuUsageText}"
                                   FontSize="34"
                                   FontWeight="Bold"
                                   Foreground="#2563EB"/>
                        <ProgressBar Minimum="0"
                                     Maximum="100"
                                     Value="{Binding CpuUsage}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Classes="panel">
                    <StackPanel Spacing="12">
                        <TextBlock Text="RAM" Classes="caption"/>
                        <TextBlock Text="{Binding RamUsageText}"
                                   FontSize="34"
                                   FontWeight="Bold"
                                   Foreground="#7C3AED"/>
                        <ProgressBar Minimum="0"
                                     Maximum="100"
                                     Value="{Binding RamUsage}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Classes="panel">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Disk" Classes="caption"/>
                        <TextBlock Text="{Binding DiskUsageText}"
                                   FontSize="34"
                                   FontWeight="Bold"
                                   Foreground="#EA580C"/>
                        <ProgressBar Minimum="0"
                                     Maximum="100"
                                     Value="{Binding DiskUsage}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Classes="panel">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Uptime" Classes="caption"/>
                        <TextBlock Text="{Binding Uptime}"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="#0F766E"/>
                        <TextBlock Text="{Binding TelegramStatus}"
                                   Classes="caption"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="2"
                  ColumnDefinitions="2*,*"
                  ColumnSpacing="18">
                <StackPanel Spacing="18">
                    <Border Classes="panel">
                        <StackPanel Spacing="16">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="График нагрузки CPU"
                                           Classes="section-title"/>
                                <TextBlock Grid.Column="1"
                                           Text="тестовые данные"
                                           Classes="caption"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <Border Background="#F8FAFC"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="18">
                                <ItemsControl ItemsSource="{Binding CpuChartPoints}"
                                              Height="240"
                                              VerticalAlignment="Bottom">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ChartPoint">
                                            <Grid RowDefinitions="*,Auto,Auto"
                                                  Margin="6,0"
                                                  VerticalAlignment="Stretch">
                                                <Border Grid.Row="0"
                                                        Width="34"
                                                        Height="{Binding Value}"
                                                        MinHeight="28"
                                                        MaxHeight="170"
                                                        Background="#2563EB"
                                                        CornerRadius="5,5,0,0"
                                                        VerticalAlignment="Bottom"
                                                        HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Row="1"
                                                           Text="{Binding Value, StringFormat={}{0}%}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="#334155"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,8,0,2"/>
                                                <TextBlock Grid.Row="2"
                                                           Text="{Binding Time}"
                                                           Classes="caption"
                                                           FontSize="11"
                                                           HorizontalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Classes="panel">
                        <StackPanel Spacing="14">
                            <TextBlock Text="Журнал событий"
                                       Classes="section-title"/>

                            <ItemsControl ItemsSource="{Binding AlertLog}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AlertLogEntry">
                                        <Border BorderBrush="#E2E8F0"
                                                BorderThickness="0,0,0,1"
                                                Padding="0,10">
                                            <Grid ColumnDefinitions="72,86,*"
                                                  ColumnSpacing="14">
                                                <TextBlock Text="{Binding Time}"
                                                           Classes="caption"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Type}"
                                                           FontWeight="SemiBold"
                                                           Foreground="#334155"/>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding Message}"
                                                           Foreground="#334155"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border Grid.Column="1" Classes="panel">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Самые нагруженные процессы"
                                   Classes="section-title"/>

                        <Grid ColumnDefinitions="*,70,90"
                              ColumnSpacing="10"
                              Margin="0,4,0,0">
                            <TextBlock Text="Процесс" Classes="caption"/>
                            <TextBlock Grid.Column="1"
                                       Text="CPU"
                                       Classes="caption"
                                       HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="2"
                                       Text="RAM"
                                       Classes="caption"
                                       HorizontalAlignment="Right"/>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding TopProcesses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ProcessMetric">
                                    <Border Background="#F8FAFC"
                                            CornerRadius="6"
                                            Padding="12"
                                            Margin="0,0,0,8">
                                        <Grid ColumnDefinitions="*,70,90"
                                              ColumnSpacing="10">
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="SemiBold"
                                                       Foreground="#1F2937"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Cpu}"
                                                       Foreground="#2563EB"
                                                       HorizontalAlignment="Right"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Memory}"
                                                       Foreground="#64748B"
                                                       HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Background="#EFF6FF"
                                CornerRadius="8"
                                Padding="14"
                                Margin="0,10,0,0">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Telegram-уведомления"
                                           FontWeight="SemiBold"
                                           Foreground="#1D4ED8"/>
                                <TextBlock Text="При превышении порогов приложение будет отправлять предупреждения в Telegram."
                                           TextWrapping="Wrap"
                                           Classes="caption"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>

</Window>
