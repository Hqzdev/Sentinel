<Styles xmlns="https://github.com/avaloniaui">
    <Style Selector="Window">
        <Setter Property="Background" Value="#F4F6F8" />
        <Setter Property="FontFamily" Value="Inter, Segoe UI, Arial" />
    </Style>

    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="#17202A" />
    </Style>

    <Style Selector="Button.menu-button">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="14 10" />
        <Setter Property="Margin" Value="0 0 0 8" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Background" Value="#E7EDF3" />
        <Setter Property="Foreground" Value="#17202A" />
    </Style>

    <Style Selector="Border.card">
        <Setter Property="Background" Value="White" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="18" />
        <Setter Property="BoxShadow" Value="0 4 14 #18000000" />
    </Style>

    <Style Selector="TextBlock.card-title">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#5D6D7E" />
    </Style>

    <Style Selector="TextBlock.metric-value">
        <Setter Property="FontSize" Value="34" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Margin" Value="0 8 0 0" />
    </Style>

    <Style Selector="ProgressBar">
        <Setter Property="Height" Value="10" />
        <Setter Property="CornerRadius" Value="5" />
    </Style>
</Styles>
