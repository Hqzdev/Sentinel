<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SystemMonitor.App.ViewModels"
        xmlns:ctrl="using:SystemMonitor.App.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
        x:Class="SystemMonitor.App.Views.LoginWindow"
        x:DataType="vm:LoginViewModel"
        Title="Sentinel"
        Width="900"
        Height="600"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        Opacity="0">

    <Design.DataContext>
        <vm:LoginViewModel/>
    </Design.DataContext>

    <!-- ════════ STYLES ════════ -->
    <Window.Styles>

        <Style Selector="TextBox.field">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="CaretBrush" Value="#6366f1"/>
            <Setter Property="SelectionBrush" Value="#6366f133"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Inter, SF Pro Text, -apple-system, sans-serif"/>
            <Setter Property="Height" Value="48"/>
        </Style>
        <Style Selector="TextBox.field:focus">
            <Setter Property="BorderBrush" Value="#6366f1"/>
        </Style>
        <Style Selector="TextBox.field:pointerover">
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
        </Style>

        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontFamily" Value="Inter, SF Pro Text, -apple-system, sans-serif"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#6366f1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Inter, SF Pro Text, -apple-system, sans-serif"/>
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#4f51d9"/>
        </Style>
        <Style Selector="Button.primary:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#4346c0"/>
        </Style>
        <Style Selector="Button.primary:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="#A5B4FC"/>
        </Style>

        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="0,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Inter, SF Pro Text, -apple-system, sans-serif"/>
        </Style>
        <Style Selector="Button.ghost:pointerover">
            <Setter Property="Foreground" Value="#64748B"/>
        </Style>

        <Style Selector="Button.icon-btn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

    </Window.Styles>

    <!-- ════════ ROOT GRID ════════ -->
    <Grid ColumnDefinitions="5*,6*">

        <!-- ▌ LEFT: Анимированная панель (тёмная — контраст со светлой формой) ▌ -->
        <Grid Grid.Column="0" Background="#0f1117">
            <ctrl:AnimatedBackground/>

            <!-- Overlay -->
            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#CC0f1117" Offset="0"/>
                        <GradientStop Color="#880c0f18" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Branding -->
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="0">

                <Border Width="60" Height="60"
                        CornerRadius="16"
                        Margin="0,0,0,20"
                        HorizontalAlignment="Center">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                            <GradientStop Color="#6366f1" Offset="0"/>
                            <GradientStop Color="#8b5cf6" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="⬡" FontSize="30" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="Sentinel"
                           FontSize="30" FontWeight="Bold" Foreground="#e2e8f0"
                           HorizontalAlignment="Center"
                           FontFamily="Inter, SF Pro Display, -apple-system, sans-serif"
                           Margin="0,0,0,8"/>

                <TextBlock Text="Мониторинг системы"
                           FontSize="13" Foreground="#475569"
                           HorizontalAlignment="Center"
                           FontFamily="Inter, SF Pro Text, -apple-system, sans-serif"
                           Margin="0,0,0,36"/>

                <StackPanel Spacing="13" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <Ellipse Width="5" Height="5" Fill="#6366f1" VerticalAlignment="Center"/>
                        <TextBlock Text="CPU, RAM, Disk в реальном времени"
                                   FontSize="12" Foreground="#64748b"
                                   FontFamily="Inter, -apple-system, sans-serif"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <Ellipse Width="5" Height="5" Fill="#10b981" VerticalAlignment="Center"/>
                        <TextBlock Text="Telegram-уведомления об алертах"
                                   FontSize="12" Foreground="#64748b"
                                   FontFamily="Inter, -apple-system, sans-serif"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <Ellipse Width="5" Height="5" Fill="#a855f7" VerticalAlignment="Center"/>
                        <TextBlock Text="История метрик и журнал событий"
                                   FontSize="12" Foreground="#64748b"
                                   FontFamily="Inter, -apple-system, sans-serif"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <TextBlock Text="v1.0" FontSize="11" Foreground="#1e293b"
                       Margin="20,0,0,14" VerticalAlignment="Bottom"
                       FontFamily="Inter, -apple-system, sans-serif"/>
        </Grid>

        <!-- ▌ RIGHT: Форма с кодом (СВЕТЛАЯ) ▌ -->
        <Border Grid.Column="1"
                Background="#F8FAFC"
                BorderBrush="#E2E8F0"
                BorderThickness="1,0,0,0">

            <StackPanel VerticalAlignment="Center"
                        Margin="52,0,52,0"
                        Spacing="0"
                        x:Name="FormPanel">

                <!-- Заголовок -->
                <TextBlock Text="Добро пожаловать"
                           FontSize="26" FontWeight="Bold" Foreground="#0F172A"
                           FontFamily="Inter, SF Pro Display, -apple-system, sans-serif"
                           Margin="0,0,0,8"/>

                <TextBlock Text="Введите имя и подключите Telegram-уведомления"
                           FontSize="13" Foreground="#64748B"
                           FontFamily="Inter, SF Pro Text, -apple-system, sans-serif"
                           Margin="0,0,0,28"/>

                <!-- Имя -->
                <TextBlock Text="Ваше имя" Classes="label"/>
                <TextBox Classes="field"
                         Text="{Binding UserName}"
                         Watermark="Например, Yaroslav"
                         Margin="0,0,0,24"/>

                <!-- Разделитель -->
                <Border Height="1" Background="#E2E8F0" Margin="0,0,0,20"/>

                <!-- Инструкция: блок кода -->
                <TextBlock Text="КОД ПОДКЛЮЧЕНИЯ"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="#94A3B8" LetterSpacing="1.2"
                           FontFamily="Inter, -apple-system, sans-serif"
                           Margin="0,0,0,10"/>

                <!-- Большой код -->
                <Border Background="#FFFFFF"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1.5"
                        CornerRadius="12"
                        Padding="0,18"
                        Margin="0,0,0,14">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding FormattedCode}"
                                   FontSize="32" FontWeight="Bold"
                                   Foreground="#0F172A"
                                   HorizontalAlignment="Center"
                                   LetterSpacing="6"
                                   FontFamily="JetBrains Mono, Cascadia Code, SF Mono, monospace"/>
                        <Button Grid.Column="1"
                                Classes="icon-btn"
                                Command="{Binding RegenerateCodeCommand}"
                                ToolTip.Tip="Сгенерировать новый код"
                                Margin="0,0,14,0">
                            ↻
                        </Button>
                    </Grid>
                </Border>

                <!-- Инструкция -->
                <Border Background="#EFF6FF"
                        BorderBrush="#BFDBFE"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14,12"
                        Margin="0,0,0,20">
                    <StackPanel Spacing="5">
                        <TextBlock FontSize="13" Foreground="#1D4ED8" FontWeight="SemiBold"
                                   FontFamily="Inter, -apple-system, sans-serif"
                                   Text="Как подключить бота:"/>
                        <TextBlock FontSize="12" Foreground="#3B82F6" TextWrapping="Wrap"
                                   FontFamily="Inter, -apple-system, sans-serif">
                            <Run Text="1. Откройте "/>
                            <Run Text="@SentinelMonitorBot" FontWeight="SemiBold"/>
                            <Run Text=" в Telegram"/>
                        </TextBlock>
                        <TextBlock FontSize="12" Foreground="#3B82F6"
                                   FontFamily="Inter, -apple-system, sans-serif"
                                   Text="2. Отправьте код выше боту"/>
                        <TextBlock FontSize="12" Foreground="#3B82F6"
                                   FontFamily="Inter, -apple-system, sans-serif"
                                   Text="3. Нажмите «Проверить»"/>
                    </StackPanel>
                </Border>

                <!-- Статус / ошибка -->
                <Border Background="#FEF2F2"
                        BorderBrush="#FECACA"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,10"
                        Margin="0,0,0,14"
                        IsVisible="{Binding HasError}">
                    <TextBlock Text="{Binding StatusText}"
                               FontSize="13" Foreground="#DC2626" TextWrapping="Wrap"
                               FontFamily="Inter, -apple-system, sans-serif"/>
                </Border>

                <Border Background="#F0FDF4"
                        BorderBrush="#BBF7D0"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,10"
                        Margin="0,0,0,14"
                        IsVisible="{Binding IsSuccess}">
                    <TextBlock Text="{Binding StatusText}"
                               FontSize="13" Foreground="#16A34A" FontWeight="SemiBold"
                               FontFamily="Inter, -apple-system, sans-serif"/>
                </Border>

                <!-- Кнопки -->
                <Button Classes="primary"
                        Command="{Binding VerifyCommand}"
                        IsEnabled="{Binding !IsVerifying}"
                        HorizontalAlignment="Stretch"
                        Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="✓  Проверить код" IsVisible="{Binding !IsVerifying}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="Проверяем..." IsVisible="{Binding IsVerifying}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Classes="ghost"
                        Command="{Binding SkipCommand}"
                        HorizontalAlignment="Stretch">
                    Пропустить — начать без Telegram
                </Button>

            </StackPanel>
        </Border>

    </Grid>
</Window>
