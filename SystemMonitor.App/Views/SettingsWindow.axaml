<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SystemMonitor.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="480" d:DesignHeight="480"
        x:Class="SystemMonitor.App.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Настройки — Sentinel"
        Width="480"
        Height="480"
        CanResize="False"
        Background="#F8FAFC">

    <Design.DataContext>
        <vm:SettingsViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="Inter, SF Pro Text, -apple-system, sans-serif"/>
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="CaretBrush" Value="#6366f1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <Style Selector="TextBox:focus">
            <Setter Property="BorderBrush" Value="#6366f1"/>
        </Style>
        <Style Selector="NumericUpDown">
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#6366f1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#4f51d9"/>
        </Style>
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.secondary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#E2E8F0"/>
        </Style>
    </Window.Styles>

    <ScrollViewer Padding="32">
        <StackPanel Spacing="4">

            <!-- Header -->
            <TextBlock Text="Настройки"
                       FontSize="26" FontWeight="Bold" Foreground="#0F172A"
                       Margin="0,0,0,4"/>
            <TextBlock Text="Пороги алертов и параметры мониторинга"
                       FontSize="13" Foreground="#64748B"
                       Margin="0,0,0,28"/>

            <!-- Telegram status (read-only info) -->
            <Border Background="#F0FDF4"
                    BorderBrush="#BBF7D0"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14,12"
                    Margin="0,0,0,24">
                <StackPanel Spacing="3">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse Width="7" Height="7" Fill="#10b981" VerticalAlignment="Center"/>
                        <TextBlock Text="Telegram подключён"
                                   FontSize="13" FontWeight="SemiBold" Foreground="#15803D"/>
                    </StackPanel>
                    <TextBlock FontSize="12" Foreground="#16A34A" Margin="15,0,0,0">
                        <Run Text="Chat ID: "/>
                        <Run Text="{Binding ChatId}"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Height="1" Background="#E2E8F0" Margin="0,0,0,20"/>

            <!-- Thresholds -->
            <TextBlock Text="Пороги алертов" Classes="section-title"/>

            <Grid ColumnDefinitions="*,16,*">
                <StackPanel>
                    <TextBlock Text="CPU (%)" Classes="label"/>
                    <NumericUpDown Value="{Binding CpuThreshold}"
                                   Minimum="1" Maximum="100" Increment="5"
                                   FormatString="F0"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="RAM (%)" Classes="label"/>
                    <NumericUpDown Value="{Binding RamThreshold}"
                                   Minimum="1" Maximum="100" Increment="5"
                                   FormatString="F0"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="Интервал опроса (сек.)" Classes="label"/>
            <NumericUpDown Value="{Binding PollingIntervalSeconds}"
                           Minimum="1" Maximum="60" Increment="1"
                           Margin="0,0,0,28"/>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="Сохранить"
                        Classes="primary"
                        Command="{Binding SaveCommand}"/>
                <Button Content="Тест уведомления"
                        Classes="secondary"
                        Command="{Binding TestNotificationCommand}"/>
            </StackPanel>

            <TextBlock Text="{Binding SaveStatus}"
                       Foreground="#059669"
                       FontWeight="SemiBold"
                       Margin="0,12,0,0"/>

        </StackPanel>
    </ScrollViewer>

</Window>
